{"nodes":[{"id":"agents_md","label":"AGENTS.md","file_type":"document","source_file":"AGENTS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"architecture_md","label":"ARCHITECTURE.md","file_type":"document","source_file":"ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"claude_md","label":"CLAUDE.md","file_type":"document","source_file":"CLAUDE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"design_md","label":"DESIGN.md","file_type":"document","source_file":"DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"pnpm_workspace_yaml","label":"pnpm-workspace.yaml","file_type":"document","source_file":"pnpm-workspace.yaml","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"readme_md","label":"README.md","file_type":"document","source_file":"README.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"themes_md","label":"THEMES.md","file_type":"document","source_file":"THEMES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"agents_lcp_tbt_optimization","label":"LCP & TBT Performance Optimization","file_type":"rationale","source_file":"AGENTS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Prevents injection of heavy libraries like GSAP on the main thread or Root Layout to avoid blocking cellular load times (Total Blocking Time). Forces dynamic loading or use-client wrappers for heavy components."},{"id":"agents_hybrid_animation","label":"Hybrid Animation Philosophy","file_type":"rationale","source_file":"AGENTS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Optimizes First Contentful Paint (FCP) to near 0ms by using pure Tailwind CSS utility animations for initial mounting. Limits interactive GSAP animations to user actions like scroll, hover, or micro-nudges."},{"id":"agents_ssot_transformation","label":"SSoT via transformEventForUI","file_type":"rationale","source_file":"AGENTS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Establishes a strict Single Source of Truth for event displays, ensuring humans, search engines (via JSON-LD), and AI agents (via llms.txt) always read identical data, preventing discrepancies in pricing, dates, and locations."},{"id":"agents_dry_colocation","label":"DRY and Domain-Driven Colocation","file_type":"rationale","source_file":"AGENTS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Eliminates clutter in the components/ folder by colocating domain components inside folders and reserving the root for page-level orchestrators. Promotes modular reuse and strictly segregated domain hooks."},{"id":"agents_solid_principles","label":"SOLID React & Next.js Principles","file_type":"rationale","source_file":"AGENTS.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Translates classic SOLID into React rules: single-responsibility components (<200 lines), open-closed extensions, minimal props to prevent drilling, and dependency inversion via helper actions."},{"id":"architecture_identity_dual","label":"Dual Identity and Authentication Strategy","file_type":"rationale","source_file":"ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Decouples public attendee identification (Clerk) from sensitive corporate admin tasks (Supabase Auth) to provide isolated security boundaries and protect master operations."},{"id":"architecture_server_actions","label":"Server Actions Data Access Layer","file_type":"rationale","source_file":"ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Replaces REST endpoints with Next.js Server Actions, restricting raw database access, CRUD operations, and external API requests exclusively to secure server runtimes."},{"id":"architecture_keap_crm_sync","label":"Keap CRM Real-Time Sync","file_type":"rationale","source_file":"ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Synchronizes contacts and tags automatically. Utilizes Supabase WebSockets to stream mass update progress to administrators in real time."},{"id":"architecture_upstash_redis_cache","label":"Upstash Redis Cache Layer","file_type":"rationale","source_file":"ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Slashes application latency and offloads database queries by caching database records and tags using high-performance Upstash Redis."},{"id":"design_tokens_v4","label":"Tailwind v4 CSS Variable-Based Tokens","file_type":"rationale","source_file":"DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Utilizes Tailwind CSS v4's direct CSS variables and @theme inline declarations to support multi-theme adaptability natively, removing the need for a tailwind.config.js file."},{"id":"design_dot_scrollbar","label":"DotScrollbar Elastic Scroll System","file_type":"rationale","source_file":"DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Acts as the single, reusable custom scroll indicator. It scales and stretches vertically via GSAP to reflect scroll speed and plays a loading wave upon initial load."},{"id":"design_animate_cards_transition","label":"animateCardsTransition Filter Orchestrator","file_type":"rationale","source_file":"DESIGN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Centralizes filter-based GSAP transition sequences, ensuring that changes to categories, subcategories, or months play identical animations without code replication."},{"id":"themes_engine_camaleonic","label":"Camaleonic Multi-Theme Engine","file_type":"rationale","source_file":"THEMES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Enables the dashboard to switch dynamically between 5 distinct themes (Light, Dark, Synthwave, Hacker, Coffee) by strictly utilizing semantic variables and CSS class mapping rather than hardcoded tailwind colors."},{"id":"themes_clerk_integration","label":"Clerk Theme Propagation","file_type":"rationale","source_file":"THEMES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Propagates the app theme variable mapping directly into Clerk authentication containers using the appearance prop to maintain a visually unified login experience."},{"id":"themes_svg_styling","label":"Camaleonic SVG Styling Rule","file_type":"rationale","source_file":"THEMES.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Forbids the use of static colors or tailwind classes within inline SVGs, forcing CSS variables inside inline style tags to guarantee correct rendering of vector shapes when themes switch."},{"id":"architecture_llms_txt_aio","label":"llms.txt AI Optimization (AIO)","file_type":"rationale","source_file":"ARCHITECTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Exposes all live, formatted event data dynamically in a standard markdown /llms.txt path, optimising search bot indexers and AI agents for factual consumption."}],"edges":[{"source":"arch